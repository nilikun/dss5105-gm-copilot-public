# Copy to deploy/deploy.env (git-ignored) and fill in. Used by compose.yaml.

# Visitors must type this code once (Settings page). Choose a fresh one; share it only with graders/teammates.
ACCESS_CODE=

# Keep true only behind the trusted Nginx configuration in docs/DEPLOY.md or Cloudflare Tunnel.
# Nginx overwrites CF-Connecting-IP with the visitor's socket IP. Use false for direct local access.
TRUST_PROXY=true

# Requests per minute per visitor for chat (each costs a model call).
RATE_LIMIT_PER_MINUTE=20

# Application-estimated model budget per UTC day; separate from Google Cloud trial credit.
DAILY_BUDGET_USD=1.0

# Optional: only for the Cloudflare tunnel profile. Leave empty for the documented GCP + Nginx setup.
# Obtain privately from Cloudflare Zero Trust → Networks → Tunnels → Install connector.
TUNNEL_TOKEN=
