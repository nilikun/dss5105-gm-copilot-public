# Copy to deploy/deploy.env (git-ignored) and fill in. Used by compose.yaml.

# Visitors must type this code once (Settings page). Choose a fresh one; share it only with graders/teammates.
ACCESS_CODE=

# Behind Cloudflare, rate-limit by the visitor's real IP (CF-Connecting-IP). Keep true when using the tunnel.
TRUST_PROXY=true

# Requests per minute per visitor for chat (each costs a model call).
RATE_LIMIT_PER_MINUTE=20

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → "Install connector" (the long token after --token).
TUNNEL_TOKEN=
