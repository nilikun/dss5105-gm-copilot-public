# Template. The private repo ships the team's settings in backend/.env.team; to use your own key or settings,
# copy this file to backend/.env (git-ignored) — values there take precedence.
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-luna
# Reasoning effort for the agent (none | low | medium | high)
LLM_REASONING_EFFORT=low
# USD per 1M tokens (OpenAI pricing page, standard tier) — used for cost tracking and the daily cap
PRICE_INPUT_PER_M=0.20
PRICE_CACHED_INPUT_PER_M=0.02
PRICE_OUTPUT_PER_M=1.20
# Hard cap on LLM spend per calendar day (UTC); requests beyond it get HTTP 429
DAILY_BUDGET_USD=1.0
# Optional: require this code in the X-Access-Code header (set it on any public deployment)
ACCESS_CODE=
# Optional LLM critic stage (see docs/PLAN.md D16): off until the ablation says otherwise
CRITIC_ENABLED=false
